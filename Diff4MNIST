   t = torch.tensor([t], device=self.device)\n        \n\n        a_bar = self.alpha_list[t].to(self.device)\n        a_bar = a_bar.view(-1, 1, 1, 1) \n        \n        noise = torch.randn_like(x).to(self.device)\n        \n        x_noisy = torch.sqrt(a_bar) * x + torch.sqrt(1 - a_bar) * noise\n        \n        return x_noisy, noise\n    def denoising(self,x,t,label):\n        c = self.unet(x,t,class_labels=label)\n        #if t != self.steps = \n            \n        return c\n","metadata":{"_uuid":"8f2839f25d086af736a60e9eeb907d3b93b6e0e5","_cell_guid":"b1076dfc-b9ad-4769-8c92-a6c4dae69d19","trusted":true,"execution":{"iopub.status.busy":"2026-02-19T13:06:03.607880Z","iopub.execute_input":"2026-02-19T13:06:03.608647Z","iopub.status.idle":"2026-02-19T13:06:03.616207Z","shell.execute_reply.started":"2026-02-19T13:06:03.608615Z","shell.execute_reply":"2026-02-19T13:06:03.615387Z"}},"outputs":[],"execution_count":8},{"cell_type":"markdown","source":"# training","metadata":{}},{"cell_type":"code","source":"img_size = 28\nin_channels = 1\nout_channels = 1\n#     def __init__(self,input_image_size,input_channels, output_channels,initial_features = 64,depth = 3,device = 'cuda'):\ndevice = 'cuda'\nmodel = diffusion_model(img_size,in_channels,out_channels).to(device)\nloss = nn.MSELoss()\noptimizer = torch.optim.AdamW(model.parameters(), lr=1e-4)\n\nepc = 10\nloss_list = []\nfor i in range(epc):\n    for batch in tqdm(train_dataloader):\n        img , label = batch\n        #print(np.shape(label))\n        img = (img * 2) - 1\n        #print(np.shape(img))\n        img = img.to(device)\n        label = label.to(device)\n        batch_size = img.shape[0]\n        t = torch.randint(0, model.steps, (batch_size,), device=device).long()\n        img_and_noise , noise = model.adding_noise(img,t)\n\n        img_and_noise = img_and_noise.to(device)\n        noise = noise.to(device)\n        out = model.denoising(img_and_noise,t,label)\n        #print(out)\n        #plot_tensor(o